# Copy to .env and adjust. Never commit .env — only this file.

# ---- Ports -----------------------------------------------------------------
WEB_PORT=3000
API_PORT=4000
SUPPLIER_ALPHA_PORT=4001
SUPPLIER_BETA_PORT=4002
SUPPLIER_GAMMA_PORT=4003

# ---- Where the core API reaches each supplier ------------------------------
SUPPLIER_ALPHA_URL=http://localhost:4001
SUPPLIER_BETA_URL=http://localhost:4002
SUPPLIER_GAMMA_URL=http://localhost:4003

# ---- Where the browser reaches the core API --------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000

# The browser origin the API accepts cross-origin requests from. The page talks
# to the API directly, so this has to match where the web app is served. Use *
# to allow any origin.
WEB_ORIGIN=http://localhost:3000

# ---- Postgres (docker compose up -d) ---------------------------------------
# Port 5433, not 5432: the container deliberately avoids the default so it
# cannot be shadowed by a Postgres already installed on the host.
DATABASE_URL=postgresql://stayfinder:stayfinder@127.0.0.1:5433/stayfinder

# Separate database for the integration tests, which truncate between cases.
TEST_DATABASE_URL=postgresql://stayfinder:stayfinder@127.0.0.1:5433/stayfinder_test

# ---- Redis -----------------------------------------------------------------
# Optional. With this unset the API falls back to an in-memory cache so the
# demo runs on a laptop with nothing installed.
REDIS_URL=redis://localhost:6379

# ---- Stripe test mode (M6) -------------------------------------------------
# Test-mode keys only. Anything starting sk_live_ does not belong in this repo.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
