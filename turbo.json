{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": [".env"],
  "globalEnv": [
    "NODE_ENV",
    "API_PORT",
    "SUPPLIER_ALPHA_PORT",
    "SUPPLIER_BETA_PORT",
    "SUPPLIER_GAMMA_PORT",
    "SUPPLIER_ALPHA_URL",
    "SUPPLIER_BETA_URL",
    "SUPPLIER_GAMMA_URL",
    "NEXT_PUBLIC_API_URL",
    "WEB_ORIGIN",
    "DATABASE_URL",
    "TEST_DATABASE_URL",
    "REDIS_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "db:generate"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["db:generate"]
    },
    "lint": {
      "dependsOn": ["db:generate"]
    },
    "typecheck": {
      "dependsOn": ["db:generate"]
    },
    "test": {
      "dependsOn": ["db:generate"]
    },
    "db:generate": {
      "inputs": ["prisma/schema.prisma", "prisma.config.ts"],
      "outputs": ["src/generated/**"]
    }
  }
}
