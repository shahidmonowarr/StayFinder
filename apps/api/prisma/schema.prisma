datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

/// Mirrors `BookingStatus` in packages/shared. A Prisma enum rather than a
/// string column so the database refuses an invalid state even if application
/// code is bypassed — and `schema-drift.test.ts` asserts these values stay
/// identical to the shared union, since two sources of truth without a check is
/// just a bug with extra steps.
/// Mirrors `TransactionKind` in packages/shared. Two kinds and no third: money
/// came in, or money went back.
enum TransactionKind {
  CHARGE
  REFUND
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  REFUNDED
  FAILED
}

/// A price a supplier confirmed at a moment in time.
///
/// Persisted rather than cached: this is the provenance of an amount we are
/// about to charge, and evicting it under memory pressure is not a trade worth
/// making on the money path. It is also what a booking references, so the price
/// charged never comes from anything the client sent us.
model Quote {
  id String @id @default(uuid())

  supplier        String
  supplierHotelId String
  hotelName       String
  city            String
  starRating      Int

  /// Calendar dates as ISO strings, matching the rest of the system. A DateTime
  /// here would invite a timezone to decide how many nights a stay is.
  checkIn  String
  checkOut String
  nights   Int
  guests   Int

  nightlyRateMinor Int
  totalMinor       Int
  currency         String
  refundable       Boolean

  /// What the client said it was displaying when it asked. Nullable because a
  /// caller need not have searched first. Advisory only — it decides what we
  /// *tell* the user, never what we charge.
  searchedTotalMinor Int?
  /// True when the live price differed from `searchedTotalMinor`.
  priceChanged       Boolean @default(false)

  expiresAt DateTime
  createdAt DateTime @default(now())

  booking Booking?

  @@index([supplier, supplierHotelId])
}

model Booking {
  id String @id @default(uuid())

  /// Unique: a quote may be booked exactly once. Enforced here rather than by a
  /// read-then-check in application code, which races under concurrency.
  quoteId String @unique
  quote   Quote  @relation(fields: [quoteId], references: [id])

  status BookingStatus @default(PENDING)

  /// Client-supplied. Unique so a replayed request cannot create a second
  /// booking — the constraint is the guarantee; the lookup is just an optimization.
  idempotencyKey String @unique
  /// Hash of the request body. A repeat key with a different payload is a client
  /// bug worth reporting rather than silently answering with the old booking.
  requestHash    String

  guestName  String
  guestEmail String

  totalMinor Int
  currency   String

  /// The payment provider's intent id. Nullable until checkout starts, and the
  /// key a webhook is matched back to a booking by.
  paymentIntentId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events       BookingEvent[]
  transactions Transaction[]
}

/// The append-only money ledger.
///
/// "Append-only" is enforced by a database trigger installed in the migration,
/// not by convention: a comment saying "never update this" is a comment, while a
/// trigger that raises on UPDATE or DELETE is a guarantee. See
/// `ledger.test.ts`, which asserts the database refuses.
model Transaction {
  id String @id @default(uuid())

  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  kind       TransactionKind
  amountMinor Int
  currency    String

  /// The provider's own id for this movement — a charge or refund reference.
  providerRef String

  createdAt DateTime @default(now())

  @@index([bookingId, createdAt])
  @@map("transactions")
}

/// Every webhook delivery we have already processed.
///
/// The provider's own event id is the primary key, which is what makes duplicate
/// delivery a no-op: the insert conflicts and the work is skipped. Stripe makes
/// no at-most-once promise and retries after any non-2xx, so this is not an edge
/// case — it is the normal operating condition.
model WebhookEvent {
  /// The provider's event id, e.g. `evt_...`. Not generated by us.
  id String @id

  type       String
  receivedAt DateTime @default(now())

  @@map("webhook_events")
}

/// Append-only state history. Never updated, never deleted — the booking's
/// timeline is reconstructed by replaying these in order, and M6's transactions
/// ledger is the same idea applied to money.
model BookingEvent {
  id String @id @default(uuid())

  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  /// Null on creation: a new booking transitions from nothing into PENDING.
  fromStatus BookingStatus?
  toStatus   BookingStatus
  /// Null on creation, since "create" is not one of the machine's transitions.
  transition String?

  at DateTime @default(now())

  @@index([bookingId, at])
}
